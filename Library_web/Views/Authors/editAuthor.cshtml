@model Library_web.Models.DTO.authorNoIdDTO
@{
    var author = ViewBag.Author;
}

<h2>Chỉnh sửa Tác giả</h2>
<form asp-controller="Authors" asp-action="editAuthor" asp-route-id="@author.Id" method="POST">
    <div class="mb-3">
        <label>Họ và tên tác giả (FullName):</label>
        <input type="text" name="FullName" value="@author.FullName" class="form-control" required />
    </div>
    <input type="submit" value="Cập nhật" class="btn btn-primary" />
    <a asp-controller="Authors" asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>