@model IEnumerable<Library_web.Models.DTO.authorDTO>

<h2>Danh sách Tác giả (Authors)</h2>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<a class="btn btn-primary mb-3" asp-controller="Authors" asp-action="addAuthor">Thêm tác giả mới</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Họ và Tên (FullName)</th>
            <th>Chi tiết</th>
            <th>Sửa</th>
            <th>Xóa</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FullName</td>
                <td><a asp-controller="Authors" asp-action="listAuthor" asp-route-id="@item.Id">Detail</a></td>
                <td><a asp-controller="Authors" asp-action="editAuthor" asp-route-id="@item.Id">Edit</a></td>
                <td><a asp-controller="Authors" asp-action="delAuthor" asp-route-id="@item.Id" onclick="return confirm('Xóa tác giả này?');">Delete</a></td>
            </tr>
        }
    </tbody>
</table>