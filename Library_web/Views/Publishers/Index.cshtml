@model IEnumerable<Library_web.Models.DTO.publisherDTO>

<h2>Danh sách Nhà xuất bản (Publishers)</h2>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<a class="btn btn-primary mb-3" asp-controller="Publishers" asp-action="addPublisher">Thêm NXB mới</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tên Nhà xuất bản (Name)</th>
            <th>Chi tiết</th>
            <th>Sửa</th>
            <th>Xóa</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td><a asp-controller="Publishers" asp-action="listPublisher" asp-route-id="@item.Id">Detail</a></td>
                <td><a asp-controller="Publishers" asp-action="editPublisher" asp-route-id="@item.Id">Edit</a></td>
                <td><a asp-controller="Publishers" asp-action="delPublisher" asp-route-id="@item.Id" onclick="return confirm('Xóa NXB này?');">Delete</a></td>
            </tr>
        }
    </tbody>
</table>