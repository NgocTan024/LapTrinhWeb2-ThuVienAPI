@model Library_web.Models.DTO.publisherNoIdDTO

<h2>Thêm Nhà xuất bản mới</h2>
<form asp-controller="Publishers" asp-action="addPublisher" method="POST">
    <div class="mb-3">
        <label>Tên Nhà xuất bản (Name):</label>
        <input type="text" asp-for="Name" class="form-control" required />
    </div>
    <input type="submit" value="Lưu" class="btn btn-success" />
    <a asp-controller="Publishers" asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>